# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Twilio (places the outbound PSTN call & records it) -------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# A Twilio phone number you own, used as the caller ID for every test call.
# Per the challenge rules, use exactly ONE number for all test calls.
TWILIO_FROM_NUMBER=+13334445555

# --- OpenAI (Realtime speech-to-speech "patient" + text bug analysis) ------
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Realtime voice-to-voice model used to play the simulated patient
OPENAI_REALTIME_MODEL=gpt-realtime
# Model used for post-call bug analysis (plain text, no audio needed)
OPENAI_ANALYSIS_MODEL=gpt-5.1

# --- Target under test -------------------------------------------------------
# Fixed by the assessment. Do not change.
TARGET_NUMBER=+18054398008

# --- Public webhook base URL (ngrok / Cloud Run / Fly.io / etc.) -----------
# Twilio needs a public HTTPS/WSS URL to reach this app for TwiML + media
# streams. Example while developing locally with ngrok:
#   ngrok http 8000
PUBLIC_BASE_URL=https://your-public-tunnel.ngrok-free.app

# --- App server ---------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# --- Call pacing -------------------------------------------------------------
# Seconds to wait between calls in a batch run, to keep pacing realistic
# and avoid hammering the target line back-to-back.
BATCH_CALL_DELAY_SECONDS=30
# Hard safety cap on call duration (seconds) so a stuck call can't run away.
MAX_CALL_DURATION_SECONDS=240
